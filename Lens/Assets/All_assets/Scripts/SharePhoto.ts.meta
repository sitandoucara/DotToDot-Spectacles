  InputLines:
    - "// @input SceneObject btn_trigger {\"hint\":\"Le bouton SHARE qui déclenche l'upload de la photo déjà capturée\"}"
    - '// @input SceneObject btn_trigger_asset {"hint":"SceneObject qui reçoit la texture du bouton trigger. Laisser vide pour utiliser btn_trigger lui-même."}'
    - '// @input Asset.Texture[] btn_trigger_assets = {} {"hint":"Textures bouton trigger : [0] = init, [1] = hover"}'
    - '// @input SceneObject sourceImageObject {"hint":"Le SceneObject photoImage sur lequel PhotoCapture a appliqué la photo. On lit sa texture, puis on y réinjecte celle téléchargée."}'
    - '// @input bool fillFrame = true {"hint":"ON = la photo remplit tout le cadre en gardant le ratio (rogne le surplus). OFF = la photo rentre entière. Doit matcher le réglage de PhotoCapture."}'
    - "// @input bool applyDownloadedTexture = true {\"hint\":\"ON = après l'upload, retélécharge la photo depuis Supabase et la réaffiche (preuve visuelle pour la démo). OFF = upload simple.\"}"
    - "// @input bool cacheBust = true {\"hint\":\"Ajoute ?t=<timestamp> à l'URL pour garantir un vrai téléchargement réseau (pas un cache).\"}"
    - '// @input float downloadRetries = 3 {"hint":"Nombre de tentatives de téléchargement. Le CDN Supabase peut mettre une seconde à servir un fichier tout juste uploadé."}'
    - '// @input float retryDelaySeconds = 0.8 {"hint":"Attente entre deux tentatives de téléchargement (secondes)."}'
    - '// @input Component.Text loadingText {"hint":"Texte affiché pendant encode/upload/download et pour succès/erreur"}'
    - "// @input string msgProcessing = \"Uploading photo...\" {\"hint\":\"Message pendant l'encodage + l'envoi\"}"
    - '// @input string msgDownloading = "Fetching from cloud..." {"hint":"Message pendant le retéléchargement depuis Supabase"}'
    - "// @input string msgDownloaded = \"Loaded from cloud!\" {\"hint\":\"Message final quand l'image affichée vient de Supabase\"}"
    - '// @input string msgSuccess = "Saved!" {"hint":"Message final quand applyDownloadedTexture est OFF (upload seul)"}'
    - '// @input string msgAlreadyShared = "Photo shared!" {"hint":"Message quand on retape SHARE sur une photo déjà partagée (2e, 3e tap...)"}'
    - "// @input string msgError = \"Upload failed\" {\"hint\":\"Message en cas d'erreur\"}"
    - '// @input float hideAfterSeconds = 2 {"hint":"Cacher le texte de statut X secondes après succès (0 = laisser affiché)"}'
    - '// @input Asset.InternetModule internetModule {"hint":"Module Internet (Asset). Requis pour fetch() et makeResourceFromUrl()."}'
    - "// @input Asset.RemoteMediaModule remoteMediaModule {\"hint\":\"Remote Media Module (Asset). Requis pour convertir l'URL en Texture.\"}"
    - '// @input string edgeFunctionUrl {"hint":"URL complète de ta Supabase Edge Function (https://<project>.supabase.co/functions/v1/<name>)"}'
    - '// @input string supabaseAnonKey {"hint":"Clé anon/api Supabase (envoyée en Authorization: Bearer + apikey)"}'
    - '// @input float jpegQuality = 2 {"hint":"Qualité JPEG : 0=MaxCompression, 1=Low, 2=Intermediate, 3=High, 4=MaxQuality. 2 = bon compromis vitesse/taille."}'
    - '// @input bool useTestImage {"hint":"ON = utilise testImage au lieu de lire sourceImageObject (test du pipeline dans le preview). OFF = vraie texture capturée."}'
    - '// @input Asset.Texture testImage {"hint":"Texture source utilisée quand useTestImage est ON."}'
